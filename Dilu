#!/usr/bin/env python3
"""Dump every unique KEY NAME in an FCG JSON (values omitted, so nothing sensitive).
Usage: python dump_keys.py data/fcg/FRA.json
Prints keys with their depth path so you can see structure, plus a flat unique list."""
import json, sys

path = sys.argv[1] if len(sys.argv) > 1 else "data/fcg/FRA.json"
data = json.load(open(path, encoding="utf-8", errors="replace"))

paths = set()
flat = set()

def walk(obj, prefix=""):
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k.endswith("Path"):      # skip the *Path metadata noise
                continue
            flat.add(k)
            p = f"{prefix}.{k}" if prefix else k
            # record the path only down to a reasonable depth for readability
            if prefix.count(".") < 4:
                paths.add(p)
            walk(v, p)
    elif isinstance(obj, list):
        for v in obj[:2]:               # first 2 list items are enough for structure
            walk(v, prefix + "[]")

walk(data)

print("===== KEY PATHS (structure, depth<=4) =====")
for p in sorted(paths):
    print(p)
print("\n===== ALL UNIQUE KEY NAMES =====")
print(", ".join(sorted(flat)))
