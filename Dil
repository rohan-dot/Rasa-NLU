find discver/src discver/tests -newer BASELINE_FAILURES.txt -type f        # what the dead agent touched — just to see
unzip -l ../discver-src-tests-FULL-nov05.zip | awk '{print $4}' | grep -E '\.py$' | sort > /tmp/full.lst
for f in $(find discver/src discver/tests -newer BASELINE_FAILURES.txt -type f -name '*.py'); do rel=${f#discver/}; grep -qx "$rel" /tmp/full.lst || { echo "deleting new file: $f"; rm -f "$f"; }; done
unzip -o -q ../discver-src-tests-FULL-nov05.zip -d discver/
cd discver && python -m pytest -q tests 2>&1 | tail -2 && cd ..
